# Base de datos principal
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/twitter_clone"

# Base de datos para tests
DATABASE_URL_TEST="postgresql://USUARIO:PASSWORD@localhost:5432/twitter_clone_test"

# Secret para firmar tokens JWT (mínimo 32 caracteres)
JWT_SECRET="un-secret-seguro-de-al-menos-32-caracteres"

# Puerto del servidor backend (default: 3001)
PORT=3001

# URL del frontend para CORS
FRONTEND_URL="http://localhost:5173"

# Cloudinary - almacenamiento de imágenes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=